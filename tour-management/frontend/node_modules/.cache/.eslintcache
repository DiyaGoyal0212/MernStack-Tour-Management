location==='' || distance=== '' || maxGroupSixe===''){\r\n        return alert('All fields required');\r\n    }\r\n   }\r\n\r\n\r\n  return <Col lg=\"12\">\r\n    <div className=\"search__bar\">\r\n        <Form className=\"d-flex align-items-center gap-4\">\r\n            <FormGroup className=\"d-flex gap-3 form__group form__group-fast\">\r\n                <span>\r\n                <i class=\"ri-map-pin-line\"></i>\r\n                </span>\r\n                <div>\r\n                    <h6>Location</h6>\r\n                    <input type=\"text\" placeholder='where are you going?' ref={LocationRef}></input>\r\n                </div>\r\n            </FormGroup>\r\n            <FormGroup className=\"d-flex gap-3 form__group form__group-fast\">\r\n                <span>\r\n                <i class=\"ri-map-pin-time-line\"></i>\r\n                </span>\r\n                <div>\r\n                    <h6>Distance</h6>\r\n                    <input type=\"number\" placeholder='Distance k/m?' ref={distanceRef}></input>\r\n                </div>\r\n            </FormGroup>\r\n            <FormGroup className=\"d-flex gap-3 form__group form__group-last\">\r\n                <span>\r\n                <i class=\"ri-group-line\"></i>\r\n                </span>\r\n                <div>\r\n                    <h6>Max People</h6>\r\n                    <input type=\"number\" placeholder='No of people ?' ref={maxGroupSixeRef}></input>\r\n                </div>\r\n            </FormGroup>\r\n\r\n            <span className=\"search__icon\" type=\"submit\">\r\n            <i class=\"ri-search-line\"></i>\r\n            </span>\r\n        </Form>\r\n    </div>\r\n  </Col>\r\n}\r\n\r\nexport default SearchBar\r\n","C:\\Users\\91941\\tournow\\MernStack-Tour-Management\\tour-management\\frontend\\src\\services\\ServiceList.jsx",[],[],"C:\\Users\\91941\\tournow\\MernStack-Tour-Management\\tour-management\\frontend\\src\\services\\ServiceCard.jsx",[],[],"C:\\Users\\91941\\tournow\\M